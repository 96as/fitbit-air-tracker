# HTTP port for the API server
PORT=3001

# SQLite database file (created on first boot)
DATABASE_PATH=data/app.db

# Sleep data provider: "mock" (built-in simulator, zero setup)
# or "google_health" (Phase 2 — requires approved API access)
PROVIDER=mock

# Mock provider: minutes of simulated device→cloud sync lag (Fitbit Air ≈ 15)
MOCK_SYNC_LAG_MIN=15

# Web Push VAPID keys — generate with: npm run vapid -w server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Phase 2 — Google Health API OAuth (see docs/INTEGRATIONS.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

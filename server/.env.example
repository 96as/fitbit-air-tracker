# HTTP port for the API server
PORT=3001

# SQLite database file (created on first boot)
DATABASE_PATH=data/app.db

# Sleep data provider: "mock" (built-in simulator, zero setup)
# or "google_health" (Phase 2 — requires approved API access)
PROVIDER=mock

# Mock provider: minutes of simulated device→cloud sync lag (Fitbit Air ≈ 15)
MOCK_SYNC_LAG_MIN=15

# Web Push VAPID keys — generate with: npm run vapid -w server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google Health API (Fitbit Air data) — create a "Web application" OAuth client in
# Google Cloud Console with this redirect URI; see docs/GOOGLE_HEALTH_API.md.
# Then set PROVIDER=google_health and open the web app's Device page to sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
# Browser origin to return to after Google sign-in
WEB_ORIGIN=http://localhost:5173
